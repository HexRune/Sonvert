<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sonvert.App.ViewModels"
             xmlns:models="using:Sonvert.App.Models"
             x:Class="Sonvert.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

  <UserControl.Styles>
    <Style Selector="Border.Card">
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.Tag">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{StaticResource NavItemHoverBrush}" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="Button.SmallAction">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="24">

    <!-- 顶部：日期筛选 + 删除整天 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
      <TextBlock Grid.Column="0" Text="历史记录" FontSize="24" FontWeight="Bold"
                 Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

      <ComboBox Grid.Column="1" Width="160" Margin="0,0,8,0"
                ItemsSource="{Binding DateFilterOptions}"
                SelectedItem="{Binding SelectedDateFilter}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryDateFilterOption">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Button Grid.Column="2" Content="删除这一天全部"
              Command="{Binding DeleteSelectedDateCommand}"
              IsEnabled="{Binding CanDeleteSelectedDate}"
              Background="{StaticResource DangerBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              Padding="14,8" CornerRadius="6" />
    </Grid>

    <!-- 记录列表 -->
    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:HistoryEntry">
            <Border Classes="Card">
              <StackPanel Spacing="6">

                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Border Classes="Tag" IsVisible="{Binding Emotion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding Emotion}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
                <Border Classes="Tag" IsVisible="{Binding Event, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding Event}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
                  </StackPanel>
                </Grid>

                <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <TextBlock TextWrapping="Wrap" FontStyle="Italic"
                           Foreground="{StaticResource TextSecondaryBrush}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}">
                      <Binding Path="TranslatedText" TargetNullValue="（无需翻译，与目标语言相同）" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>

                <!-- 延迟明细——三段拆开显示 + 一个总计，方便以后对比不同
                     模型/服务商在真实使用中的延迟表现。IsVisible 绑的是
                     字符串是否非空，这次改动之前的老记录三段延迟全是
                     null，LatencyBreakdownDisplay 会是空字符串，这一行
                     自然不显示，不需要额外判断"是不是老数据"。 -->
                <StackPanel Orientation="Horizontal" Spacing="10"
                            IsVisible="{Binding LatencyBreakdownDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding LatencyBreakdownDisplay}"
                             FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding TotalLatencyDisplay}"
                             FontSize="11" FontWeight="SemiBold"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="SmallAction" Content="播放原文"
                          Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).PlaySourceCommand}"
                          CommandParameter="{Binding}"
                          Background="{StaticResource NavItemHoverBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}" />
                  <Button Classes="SmallAction" Content="播放译文"
                          Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).PlayTranslatedCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding TranslatedAudioRelativePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                          Background="{StaticResource NavItemHoverBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}" />
                  <Button Classes="SmallAction" Content="删除"
                          Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).DeleteEntryCommand}"
                          CommandParameter="{Binding}"
                          Background="{StaticResource DangerBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>