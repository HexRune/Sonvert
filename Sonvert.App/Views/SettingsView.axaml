<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sonvert.App.ViewModels"
             xmlns:models="using:Sonvert.App.Models"
             x:Class="Sonvert.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <!-- 每个设置分组统一用这个卡片外观：深色描边、圆角、内边距 -->
    <Style Selector="Border.SettingsCard">
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style Selector="TextBlock.SectionTitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.FieldLabel">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Padding="32,24">
    <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">

      <TextBlock Text="设置" FontSize="24" FontWeight="Bold"
                 Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20" />

      <!-- ===== 语音识别 ===== -->
      <Border Classes="SettingsCard">
        <StackPanel>
          <TextBlock Classes="SectionTitle" Text="语音识别（SenseVoice）" />

          <TextBlock Classes="FieldLabel" Text="服务端口" />
          <TextBox Text="{Binding SenseVoicePort}" Width="120" HorizontalAlignment="Left" />

          <TextBlock Classes="FieldLabel" Text="python.exe 路径" />
          <TextBox Text="{Binding SenseVoiceExecutablePath}" />

          <TextBlock Classes="FieldLabel" Text="工作目录" />
          <TextBox Text="{Binding SenseVoiceWorkingDirectory}" />

          <TextBlock Classes="FieldLabel" Text="VAD 模型文件路径（.onnx）" />
          <TextBox Text="{Binding VadModelPath}" />

          <TextBlock Classes="FieldLabel" Text="模型精度" />
          <ComboBox SelectedItem="{Binding ModelPrecision}" Width="160" HorizontalAlignment="Left">
            <ComboBoxItem Content="fp32" />
            <ComboBoxItem Content="int8" />
          </ComboBox>
        </StackPanel>
      </Border>

      <!-- ===== 机器翻译 ===== -->
      <Border Classes="SettingsCard">
        <StackPanel>
          <TextBlock Classes="SectionTitle" Text="机器翻译（MT）" />

          <TextBlock Classes="FieldLabel" Text="翻译提供方" />
          <ComboBox SelectedItem="{Binding TranslationProvider}" Width="160" HorizontalAlignment="Left">
            <ComboBoxItem Content="local" />
            <ComboBoxItem Content="api" />
          </ComboBox>

          <TextBlock Classes="FieldLabel" Text="服务端口" />
          <TextBox Text="{Binding MtPort}" Width="120" HorizontalAlignment="Left" />

          <TextBlock Classes="FieldLabel" Text="python.exe 路径" />
          <TextBox Text="{Binding MtExecutablePath}" />

          <TextBlock Classes="FieldLabel" Text="工作目录" />
          <TextBox Text="{Binding MtWorkingDirectory}" />

          <TextBlock Classes="FieldLabel"
                     Text="第三方 API（尚未接入，先占位）" />
          <TextBox Text="{Binding TranslationApiEndpoint}" Watermark="API 地址" IsEnabled="False" Margin="0,0,0,6" />
          <TextBox Text="{Binding TranslationApiKey}" Watermark="API Key" IsEnabled="False" PasswordChar="*" Margin="0,0,0,6" />
          <TextBox Text="{Binding TranslationApiModel}" Watermark="模型名" IsEnabled="False" />
        </StackPanel>
      </Border>

      <!-- ===== 语音合成 ===== -->
      <Border Classes="SettingsCard">
        <StackPanel>
          <TextBlock Classes="SectionTitle" Text="语音合成（GPT-SoVITS）" />

          <TextBlock Classes="FieldLabel" Text="合成提供方" />
          <ComboBox SelectedItem="{Binding TtsProvider}" Width="160" HorizontalAlignment="Left">
            <ComboBoxItem Content="local" />
            <ComboBoxItem Content="api" />
          </ComboBox>

          <TextBlock Classes="FieldLabel" Text="服务端口" />
          <TextBox Text="{Binding TtsPort}" Width="120" HorizontalAlignment="Left" />

          <TextBlock Classes="FieldLabel" Text="python.exe 路径（整合包 runtime\python.exe）" />
          <TextBox Text="{Binding TtsExecutablePath}" />

          <TextBlock Classes="FieldLabel" Text="GPT-SoVITS 整合包根目录" />
          <TextBox Text="{Binding TtsWorkingDirectory}" />

          <TextBlock Classes="FieldLabel" Text="参考音频语言（prompt_lang，如 zh / en）" />
          <TextBox Text="{Binding TtsReferenceAudioLanguage}" Width="120" HorizontalAlignment="Left" />

          <TextBlock Classes="FieldLabel"
                     Text="第三方 API（尚未接入，先占位）" />
          <TextBox Text="{Binding TtsApiEndpoint}" Watermark="API 地址" IsEnabled="False" Margin="0,0,0,6" />
          <TextBox Text="{Binding TtsApiKey}" Watermark="API Key" IsEnabled="False" PasswordChar="*" Margin="0,0,0,6" />
          <TextBox Text="{Binding TtsApiModel}" Watermark="模型名" IsEnabled="False" />
        </StackPanel>
      </Border>

      <!-- ===== 情绪参考音频 ===== -->
      <Border Classes="SettingsCard">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="SectionTitle" Text="情绪参考音频" />
            <Button Grid.Column="1" Content="+ 添加情绪"
                    Command="{Binding AddEmotionClipCommand}"
                    Background="{StaticResource NavItemHoverBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Padding="12,6" CornerRadius="6" />
          </Grid>

          <TextBlock Text="每种情绪对应一段参考音频——合成时会按识别出的情绪标签自动选用。NEUTRAL 是必需的兜底项。"
                     Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                     TextWrapping="Wrap" Margin="0,0,0,12" />

          <ItemsControl ItemsSource="{Binding EmotionClips}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:EmotionReferenceClipItem">
                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14" Margin="0,0,0,10">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Grid.Column="0" Text="{Binding Emotion}"
                               Watermark="情绪标签，如 HAPPY / ANGRY"
                               FontWeight="SemiBold" />
                      <Button Grid.Column="1" Content="删除"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveEmotionClipCommand}"
                              CommandParameter="{Binding}"
                              Background="{StaticResource DangerBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Padding="10,4" CornerRadius="6" Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Classes="FieldLabel" Text="参考音频路径" />
                    <TextBox Text="{Binding AudioPath}" />

                    <TextBlock Classes="FieldLabel" Text="参考音频对应文本" />
                    <TextBox Text="{Binding PromptText}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="SettingsCard">
      <StackPanel>
        <TextBlock Classes="SectionTitle" Text="历史记录" />
        <TextBlock Classes="FieldLabel" Text="自动清理保留天数（0 表示不自动清理，永久保留）" />
        <TextBox Text="{Binding HistoryRetentionDays}" Width="120" HorizontalAlignment="Left" />
      </StackPanel>
      </Border>

        <Border Classes="SettingsCard">
  <StackPanel>
    <TextBlock Classes="SectionTitle" Text="翻译术语表" />
    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10"
               Text="识别到左边的词/短语时，翻译前会直接替换成右边指定的内容再交给翻译模型。" />

    <Grid ColumnDefinitions="*,*,Auto" Margin="0,0,0,10">
      <TextBox Grid.Column="0" Text="{Binding NewGlossarySourceTerm}" Watermark="原文术语" Margin="0,0,6,0" />
      <TextBox Grid.Column="1" Text="{Binding NewGlossaryTargetTerm}" Watermark="目标译文" Margin="0,0,6,0" />
      <Button Grid.Column="2" Content="添加" Command="{Binding AddGlossaryEntryCommand}"
              Background="{StaticResource AccentBrush}" Foreground="{StaticResource BackgroundBrush}"
              Padding="14,6" CornerRadius="6" />
    </Grid>

    <ItemsControl ItemsSource="{Binding GlossaryEntries}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="models:GlossaryEntry">
          <Grid ColumnDefinitions="*,*,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="{Binding SourceTerm}" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding TargetTerm}" Foreground="{StaticResource TextSecondaryBrush}" />
            <Button Grid.Column="2" Content="删除"
                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteGlossaryEntryCommand}"
                    CommandParameter="{Binding}"
                    Background="{StaticResource DangerBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                    Padding="10,4" CornerRadius="6" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</Border>

      <!-- ===== 保存 ===== -->
      <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,32">
        <TextBlock Grid.Column="0" Text="{Binding SaveStatusMessage}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="保存设置"
                Command="{Binding SaveCommand}"
                Background="{StaticResource AccentBrush}"
                Foreground="{StaticResource BackgroundBrush}"
                FontWeight="SemiBold"
                Padding="24,10" CornerRadius="8" />
      </Grid>

    </StackPanel>
  </ScrollViewer>
</UserControl>