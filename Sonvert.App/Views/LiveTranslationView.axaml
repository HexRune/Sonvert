<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sonvert.App.ViewModels"
             xmlns:models="using:Sonvert.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Sonvert.App.Views.LiveTranslationView"
             x:DataType="vm:LiveTranslationViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="24">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
      <Button Content="开始识别"
              Command="{Binding StartCommand}"
              IsVisible="{Binding !IsRunning}"
              Background="{StaticResource AccentBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              Padding="20,8" CornerRadius="6" />
    </StackPanel>

    <TextBlock Grid.Row="1"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
               Foreground="{StaticResource DangerBrush}"
               Margin="0,12,0,0"
               TextWrapping="Wrap" />

    <!-- 识别结果列表：每一条用 Grid 分两栏——左边原文+译文纵向堆叠，
         限制最大宽度、超出自动换行；右边单独一小块放情绪/场景标签，
         宽度固定，不会被左边的长文本挤压掉。 -->
    <ScrollViewer Grid.Row="2" Margin="0,16,0,0">
      <ItemsControl ItemsSource="{Binding Results}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:RecognitionResultItem">
            <Border BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,12">
              <Grid ColumnDefinitions="*,Auto">

                <!-- 左栏：原文在上，译文在下，纵向堆叠 -->
                <StackPanel Grid.Column="0" Spacing="6" MaxWidth="700"
                            HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Text}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             FontSize="15"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding TranslatedText}"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             FontSize="15"
                             FontStyle="Italic"
                             TextWrapping="Wrap" />
                </StackPanel>

                <!-- 右栏：情绪 + 场景，固定宽度的一小块区域，
                     跟左边的文本长度完全无关，不会被压缩。 -->
                <StackPanel Grid.Column="1" Spacing="4" Width="90"
                            Margin="16,0,0,0" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Emotion}"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             FontSize="12"
                             HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding Event}"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             FontSize="12"
                             HorizontalAlignment="Right" />
                </StackPanel>

              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </Grid>
</UserControl>