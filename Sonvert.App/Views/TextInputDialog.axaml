<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sonvert.App.Views.TextInputDialog"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        RequestedThemeVariant="Dark">

  <!--
    通用的"输入一行文字"弹窗，跟具体业务无关（IDialogService 接口里的
    ShowTextInputAsync 用这个）。没有像 MainWindow 那样自绘标题栏——
    一个只弹出来几秒钟、用完就关的小对话框，值不值得为它重新实现一遍
    拖拽/最小化/最大化那一整套自绘标题栏逻辑？不值得，用系统默认的
    标题栏（只有一个关闭按钮）更省事，也是很多桌面软件对话框的常见
    做法，不是所有窗口都得跟主窗口长一模一样。
  -->
  <StackPanel Margin="20" Spacing="14">
    <TextBlock x:Name="MessageText"
               Foreground="{StaticResource TextSecondaryBrush}"
               FontSize="13" TextWrapping="Wrap" />

    <TextBox x:Name="InputTextBox"
             Background="{StaticResource SurfaceBrush}"
             BorderBrush="{StaticResource CardBorderBrush}"
             Foreground="{StaticResource TextPrimaryBrush}"
             CornerRadius="6" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="取消"
              Background="{StaticResource NavItemHoverBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              Padding="16,7" CornerRadius="6" />
      <Button x:Name="ConfirmButton" Content="确定"
              Background="{StaticResource AccentBrush}"
              Foreground="{StaticResource BackgroundBrush}"
              Padding="16,7" CornerRadius="6" />
    </StackPanel>
  </StackPanel>
</Window>
