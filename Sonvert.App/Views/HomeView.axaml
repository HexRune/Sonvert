<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sonvert.App.ViewModels"
             xmlns:models="using:Sonvert.App.Models"
             x:Class="Sonvert.App.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             >

  <UserControl.Styles>
    <Style Selector="Border.SettingsCard">
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="TextBlock.FieldLabel">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Width" Value="200" />
    </Style>

    <!-- 分段按钮外观：两个 RadioButton 并排，选中的高亮。RadioButton
         默认带一个圆形选择框，这里通过覆盖 Template 去掉，只保留文字+背景色。 -->
    <Style Selector="RadioButton.SegmentButton">
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                               HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.SegmentButton:checked">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}" />
    </Style>
    <Style Selector="RadioButton.SegmentButton:unchecked">
      <Setter Property="Background" Value="{StaticResource NavItemHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Margin="32,24" MaxWidth="600" Spacing="20">
    <TextBlock Text="Sonvert" FontSize="28" FontWeight="Bold"
               Foreground="{StaticResource TextPrimaryBrush}" />
    <TextBlock Text="实时同声传译" FontSize="14"
               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,-14,0,0" />
    <Border Classes="SettingsCard">
      <StackPanel Spacing="16">
      <TextBlock Classes="FieldLabel" Text="语音识别语言" />
      <ComboBox ItemsSource="{Binding RecognitionLanguageOptions}"
                SelectedValue="{Binding RecognitionLanguage}"
                SelectedValueBinding="{Binding Code}"
                Width="200">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LanguageOption">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
        <!-- 语音识别模型精度：两个互斥按钮，替代原来的 ToggleSwitch -->
        <StackPanel>
          <TextBlock Classes="FieldLabel" Text="语音识别模型精度" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <RadioButton Classes="SegmentButton" GroupName="ModelPrecision"
                         Content="fp32" IsChecked="{Binding IsFp32Selected}" />
            <RadioButton Classes="SegmentButton" GroupName="ModelPrecision"
                         Content="int8" IsChecked="{Binding IsInt8Selected}" />
          </StackPanel>
        </StackPanel>

        <!-- 翻译目标语言 -->
        <StackPanel>
          <TextBlock Classes="FieldLabel" Text="翻译目标语言" />
          <ComboBox ItemsSource="{Binding TargetLanguageOptions}"
                    SelectedValue="{Binding TargetLanguage}"
                    SelectedValueBinding="{Binding Code}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LanguageOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="FieldLabel" Text="发声角色" />
          <ComboBox ItemsSource="{Binding Characters}"
                    SelectedItem="{Binding SelectedCharacter}"
                    Width="200">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:Character">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

      </StackPanel>
    </Border>

    <Button Content="开始翻译"
            Command="{Binding StartTranslationCommand}"
            Background="{StaticResource AccentBrush}"
            Foreground="{StaticResource BackgroundBrush}"
            FontWeight="SemiBold" FontSize="16"
            Padding="0,14" HorizontalContentAlignment="Center"
            HorizontalAlignment="Stretch"
            CornerRadius="8" />
  </StackPanel>
</UserControl>