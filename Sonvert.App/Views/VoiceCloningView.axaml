<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sonvert.App.ViewModels"
             xmlns:models="using:Sonvert.App.Models"
             x:Class="Sonvert.App.Views.VoiceCloningView"
             x:DataType="vm:VoiceCloningViewModel">

  <UserControl.Styles>
    <!--
      ===== 视觉基调对齐首页的"调音台"风格 =====
      卡片用 SurfaceBrush 打底（比背景色略亮，做出面板浮起的层次感），
      必需/可选槽位靠左侧一条竖线的颜色区分（必需=强调色，可选=普通
      边框色），跟首页 API 展开区当初用过的"左侧竖线暗示额外信息"是
      同一个视觉语言。

      语言标签页（BrowserTab/TabBody）的样式直接复制了一份首页 HomeView.axaml
      里的定义，没有抽成共享资源——两个页面各自独立维护一份完全一样的
      样式，暂时不去动首页已经调好的东西；如果以后想统一，可以把这两处
      提取到 Styles/ 下的共享文件里。
    -->
    <Style Selector="RadioButton.BrowserTab">
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="6,6,0,0"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                               HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.BrowserTab:checked">
      <!-- 要跟下面 Border.TabBody 的背景色保持一致（这个页面用的是
           SurfaceBrightBrush，不是首页那个 BackgroundBrush），选中的
           标签才能跟下方内容区真正无缝相连，不然选中态标签和它下面的
           内容区会是两个不同的颜色，衔接处会露出一条明显的分界线。 -->
      <Setter Property="Background" Value="{StaticResource SurfaceBrightBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.BrowserTab:unchecked">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.TabBody">
      <!-- 这个页面的 TabBody 背景用 SurfaceBrightBrush（比 SurfaceBrush
           亮度差距更大的一档，见 Colors.axaml 里的说明）——之前试过用
           SurfaceBrush，跟背景色只差 6 个色阶，肉眼看差别很小；换成
           SurfaceBrightBrush 之后跟选中角色的背景色能真正对上、也能
           看出明显区别。跟首页语言标签页的 TabBody（用 BackgroundBrush，
           因为首页那边外面还包了一层 SurfaceBrush 的卡片，靠"卡片面 vs
           凹陷内容区"制造层次感）不是同一种视觉逻辑：这个页面右侧内容区
           外面没有包卡片，直接铺在页面画布上。 -->
      <Setter Property="Background" Value="{StaticResource SurfaceBrightBrush}" />
      <Setter Property="CornerRadius" Value="0,6,6,6" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <!-- 情绪录音卡片：SurfaceBrush 打底，左侧竖线颜色区分必需/可选。 -->
    <Style Selector="Border.EmotionCard">
      <!-- 情绪卡片改用 BackgroundBrush（比外层 TabBody 的 SurfaceBrush
           暗一档）——外层面板变亮之后，如果卡片还是同样的 SurfaceBrush，
           卡片会直接"融进"面板里，看不出卡片和卡片之间、卡片和面板
           之间的边界了。改成比面板暗一档，做出"面板上嵌了一格一格
           凹槽"的层次感，跟首页那套"卡片面 vs 凹陷内容区"是同一个
           视觉语言，只是这里反过来用（面板亮、卡片暗）。 -->
      <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,14,16,14" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <!-- 必需槽位（每种语言的 NEUTRAL）：左侧竖线用强调色，比较醒目。 -->
    <Style Selector="Border.EmotionCard.Required">
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <!-- 可选槽位：左侧竖线用普通边框色，不抢眼。 -->
    <Style Selector="Border.EmotionCard.Optional">
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    </Style>

    <!-- 必需/可选标签——一个小圆角矩形标签贴在情绪名旁边。 -->
    <Style Selector="Border.RequirementTag">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
    </Style>
    <Style Selector="Border.RequirementTag.Required">
      <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="Border.RequirementTag.Optional">
      <Setter Property="Background" Value="{StaticResource NavItemHoverBrush}" />
    </Style>
    <Style Selector="TextBlock.RequirementTagText">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.RequirementTag.Required TextBlock.RequirementTagText">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.RequirementTag.Optional TextBlock.RequirementTagText">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- 锁住状态：整张卡片压暗，配合 IsEnabled="False" 一起表达
         "现在不能操作"——Fluent 主题会自动把禁用的子控件变灰，这里
         再额外把卡片背景也压暗一点，锁住的卡片和正常卡片的区别更明显，
         不用等用户点了才发现点不动。 -->
    <Style Selector="Border.EmotionCard.Locked">
      <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 角色列表里"两种语言 NEUTRAL 都没录"的警告标。 -->
    <Style Selector="TextBlock.CharacterWarningBadge">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="24">

    <TextBlock Grid.Row="0" Text="声音克隆"
               FontSize="25"
               Foreground="{StaticResource TextSecondaryBrush}"
               Margin="0,0,0,20" />

    <!-- 左侧列宽从 260 收窄到 190——角色名通常不长，之前的宽度显得
         空荡荡的，也让右侧内容区能多分到一些空间。 -->
    <Grid Grid.Row="1" ColumnDefinitions="190,*" ColumnSpacing="16">

    <!-- 左侧：角色列表——做成"竖向标签页"的样式，跟右侧内容区共用同一个
         背景色（SurfaceBrush），靠颜色一致来体现"这两块是关联的"。 -->
    <StackPanel Grid.Column="0" Spacing="8">
      <!-- "角色"和"情绪参考音频"现在是同级副标题，"+ 新建角色"贴着这一列
           的最右侧——用 Grid 两列（标题占 * 靠左、按钮占 Auto 靠右）而
           不是 StackPanel 横向紧挨着排，两者之间会撑开到整列宽度。 -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="角色" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Command="{Binding CreateCharacterCommand}"
                Background="Transparent"
                Foreground="{StaticResource TextSecondaryBrush}"
                FontSize="12" Padding="0" CornerRadius="5"
                VerticalAlignment="Center">
          <Button.Styles>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="{StaticResource NavItemHoverBrush}" />
            </Style>
          </Button.Styles>
          <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                  CornerRadius="5" Padding="7,2">
            <TextBlock Text="+ 新建角色" />
          </Border>
        </Button>
      </Grid>

      <ListBox ItemsSource="{Binding Characters}"
               SelectedItem="{Binding SelectedCharacter}"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.Styles>
          <!-- 选中项背景色 = SurfaceBrightBrush，跟右侧内容面板
               （情绪参考音频那个 Border.TabBody）用的是同一个颜色——
               两边背景色一致，才是真正意义上的"这个角色对应那块内容"，
               不是只靠文字加粗/变亮这种弱提示。用 SurfaceBrightBrush
               而不是更接近背景色的 SurfaceBrush，是因为亮度差距太小
               肉眼分辨不出来（实测反馈过一次），特意选了跨度更大的
               一档。 -->
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource NavItemHoverBrush}" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceBrightBrush}" />
          </Style>
          <Style Selector="ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
          <!-- 删除按钮默认隐藏，鼠标悬停到这一整行时才浮现——平时列表
               干净，不会有一排常驻的小叉号分散注意力。 -->
          <Style Selector="Button.DeleteCharacterButton">
            <Setter Property="Opacity" Value="0" />
          </Style>
          <Style Selector="ListBoxItem:pointerover Button.DeleteCharacterButton">
            <Setter Property="Opacity" Value="1" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:Character">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <!-- 两种语言的 NEUTRAL 都没录时，这个角色实际上还不能用于
                     合成——用一个感叹号提前提醒，不用等选中/开始翻译才
                     发现问题。 -->
                <TextBlock Classes="CharacterWarningBadge"
                           Text="⚠"
                           IsVisible="{Binding HasNoUsableVoice}"
                           ToolTip.Tip="中文/英文的 NEUTRAL 参考音频都还没录，暂时无法用于合成"
                           VerticalAlignment="Center" />
              </StackPanel>

              <Button Grid.Column="1" Classes="DeleteCharacterButton"
                      Command="{Binding $parent[ListBox].((vm:VoiceCloningViewModel)DataContext).DeleteCharacterCommand}"
                      CommandParameter="{Binding}"
                      Background="Transparent"
                      Foreground="{StaticResource DangerBrush}"
                      Padding="6,0" FontSize="14"
                      VerticalAlignment="Center"
                      ToolTip.Tip="删除角色">
                <TextBlock Text="✕" />
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

    </StackPanel>

    <!-- 右侧：语言标签页 + 选中语言下的情绪录音槽位 -->
    <DockPanel Grid.Column="1" LastChildFill="True">
      <TextBlock DockPanel.Dock="Top" Text="情绪参考音频" FontSize="18" FontWeight="Bold"
                 Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

      <!-- 语言标签页——切换后 EmotionSlots 会整体重建成对应语言的槽位。 -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4">
        <RadioButton Classes="BrowserTab" GroupName="VoiceCloningLanguage"
                     Content="中文" IsChecked="{Binding IsChineseTabSelected}" />
        <RadioButton Classes="BrowserTab" GroupName="VoiceCloningLanguage"
                     Content="English" IsChecked="{Binding IsEnglishTabSelected}" />
      </StackPanel>

      <Border Classes="TabBody">
        <ScrollViewer Padding="0,0,20,0">
          <!-- Padding 留出滚动条空间，跟实时翻译页那个滚动条遮挡问题
               是同一个修法。 -->
          <ItemsControl ItemsSource="{Binding EmotionSlots}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EmotionSlotViewModel">
                <Border Classes="EmotionCard"
                        Classes.Required="{Binding IsRequired}"
                        Classes.Optional="{Binding !IsRequired}"
                        Classes.Locked="{Binding IsLocked}"
                        IsEnabled="{Binding !IsLocked}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding EmotionDisplay}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Classes="RequirementTag"
                                Classes.Required="{Binding IsRequired}"
                                Classes.Optional="{Binding !IsRequired}">
                          <TextBlock Classes="RequirementTagText"
                                     Text="{Binding RequirementLabel}" />
                        </Border>
                        <TextBlock Text="🔒 先录 NEUTRAL 解锁"
                                   IsVisible="{Binding IsLocked}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="已录制"
                                 IsVisible="{Binding IsRecorded}"
                                 Foreground="{StaticResource MeterNormalBrush}" FontSize="12"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <TextBox Text="{Binding ScriptText}" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="60" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{Binding RecordButtonText}"
                              Command="{Binding ToggleRecordingCommand}"
                              Background="{StaticResource DangerBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Padding="14,6" CornerRadius="6" />
                      <Button Content="试听" Command="{Binding PlayPendingCommand}"
                              IsEnabled="{Binding CanPreview}"
                              Background="{StaticResource NavItemHoverBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Padding="14,6" CornerRadius="6" />
                      <Button Content="保存" Command="{Binding SaveCommand}"
                              IsEnabled="{Binding HasPendingAudio}"
                              Background="{StaticResource AccentBrush}"
                              Foreground="{StaticResource BackgroundBrush}"
                              Padding="14,6" CornerRadius="6" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </DockPanel>
    </Grid>
  </Grid>
</UserControl>
