<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sonvert.App.ViewModels"
        xmlns:models="using:Sonvert.App.Models"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="Sonvert.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sonvert - 实时同声传译"
        Width="1200" Height="800"
        Background="{StaticResource BackgroundBrush}"
        RequestedThemeVariant="Dark">

  <!-- 整体两栏布局：左侧固定宽度侧边栏 + 右侧内容区（占满剩余空间） -->
  <Grid ColumnDefinitions="250,*">

    <!-- ===== 侧边栏 ===== -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
      <DockPanel>

        <!-- 顶部标题 -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Sonvert"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="24,24,24,16" />

        <!--
          导航列表：用 ListBox 承载而不是手写一堆 Button，是因为 ListBox
          原生就有 SelectedItem 双向绑定和选中态样式，不用自己手写选中
          高亮的状态切换逻辑。下面 Styles 里把默认的 ListBox/ListBoxItem
          外观（边框、默认高亮色）全部覆盖掉，改成截图里那种简洁风格。
        -->
        <ListBox ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedNavItem}"
                 Background="Transparent"
                 Margin="12,0"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:NavItem">
              <TextBlock Text="{Binding Title}"
                         FontSize="14"
                         Margin="12,10" />
            </DataTemplate>
          </ListBox.ItemTemplate>

          <ListBox.Styles>
            <!-- 默认（未选中）状态：灰色文字，无背景 -->
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="CornerRadius" Value="8" />
              <Setter Property="Margin" Value="0,2" />
              <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>
            <!-- 悬停状态：浅色背景提示可点击 -->
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="{StaticResource NavItemHoverBrush}" />
            </Style>
            <!-- 选中状态：白色文字 + 深一点的背景块，对应截图里"实时翻译"高亮的效果 -->
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Background" Value="{StaticResource NavItemActiveBrush}" />
            </Style>
            <Style Selector="ListBoxItem:selected TextBlock">
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
          </ListBox.Styles>
        </ListBox>

      </DockPanel>
    </Border>

    <!-- ===== 主内容区 ===== -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">

      <!--
        顶部状态栏：只在翻译会话运行时显示（IsSessionActive），不跟"当前
        选中哪个页面"挂钩——因为切到其他页面不会停止后台会话，状态栏应该
        跟着会话状态走，不是跟着页面走。IsVisible=false 时这一行不占空间，
        下面内容区会自然顶到最上面，不会留出一块空白。
      -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20"
            IsVisible="{Binding IsSessionActive}">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="10" Height="10" Fill="{StaticResource DangerBrush}" />
          <TextBlock Text="正在监听麦克风..."
                     Foreground="{StaticResource TextSecondaryBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Button Grid.Column="1"
                Content="停止"
                Command="{Binding StopSessionCommand}"
                Background="{StaticResource DangerBrush}"
                Foreground="{StaticResource TextPrimaryBrush}"
                Padding="20,8"
                CornerRadius="6" />
      </Grid>

      <!--
        内容区：CurrentPage 是 null 时（对应页面还没搭好的菜单项），显示
        占位文字；不是 null 时，ContentControl 靠 ViewLocator（按 ViewModel
        类型名自动映射到对应 View）渲染出真正的页面内容。两个控件的
        IsVisible 用 ObjectConverters.IsNull/IsNotNull 互斥控制，同一时间
        只有一个显示。
      -->
      <TextBlock Grid.Row="1"
                 Text="{Binding SelectedNavItem.Title, StringFormat='{}{0} 页面待搭建'}"
                 IsVisible="{Binding CurrentPage, Converter={x:Static conv:ObjectConverters.IsNull}}"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="16" />

      <ContentControl Grid.Row="1"
                       Content="{Binding CurrentPage}"
                       IsVisible="{Binding CurrentPage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
    </Grid>

  </Grid>
</Window>
