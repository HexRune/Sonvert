<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sonvert.App.ViewModels"
        xmlns:models="using:Sonvert.App.Models"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="Sonvert.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sonvert - 实时同声传译"
        Width="1200" Height="800"
        Background="{StaticResource BackgroundBrush}"
        RequestedThemeVariant="Dark"

        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Styles>
    <!-- 呼吸灯：透明度在 0.3~1.0 之间无限循环渐变，1.2 秒一个周期。
         只用在顶部横幅栏的运行状态指示点上，那条栏本身只在会话运行中
         才显示，所以这个动画不需要区分"运行/空闲"两种触发条件——
         元素一出现在可视树里就是在播放。 -->
    <Style Selector="Ellipse.Breathing">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.3" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1.0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <!--
    整体改成上下两段：第 0 行是自绘的标题栏（拖拽区域 + 右上角三个窗口
    按钮），第 1 行是原来的"侧边栏+内容区"两栏布局，整体不变，只是被
    包进了这个外层 Grid 的第二行。ExtendClientAreaToDecorationsHint 让
    窗口内容占满了系统标题栏原本的位置，NoChrome 让系统不再自己画任何
    标题栏/按钮，完全由这里的 XAML 负责。
  -->
  <Grid RowDefinitions="36,*">

    <!-- ===== 自绘标题栏 ===== -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
          Background="{StaticResource SidebarBrush}"
          Name="TitleBarDragArea">

      <!-- 左边这一大块留空、不放任何内容——按要求不显示图标/软件名，
           但这块区域本身要能拖拽窗口，靠 code-behind 里对整个
           TitleBarDragArea 注册的 PointerPressed 处理，不需要在这里
           单独再包一层。 -->

      <!-- 右上角窗口控制按钮：最小化 / 最大化还原 / 关闭 -->
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Name="MinimizeButton"
                Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                Classes="TitleBarButton" />
        <Button Name="MaximizeRestoreButton"
                Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                Classes="TitleBarButton" />
        <Button Name="CloseButton"
                Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                Classes="TitleBarButton TitleBarCloseButton" />
      </StackPanel>

      <Grid.Styles>
        <Style Selector="Button.TitleBarButton">
          <Setter Property="Width" Value="46" />
          <Setter Property="Height" Value="36" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
          <Setter Property="FontSize" Value="10" />
          <Setter Property="CornerRadius" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TitleBarButton:pointerover">
          <Setter Property="Background" Value="{StaticResource NavItemHoverBrush}" />
          <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <!-- 关闭按钮悬停单独给红色警示色，跟其余两个按钮区分开，
             这是系统标题栏的通用习惯，用户会本能地按这个预期去找关闭按钮。 -->
        <Style Selector="Button.TitleBarCloseButton:pointerover">
          <Setter Property="Background" Value="{StaticResource DangerBrush}" />
          <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
      </Grid.Styles>
    </Grid>

    <!-- ===== 原来的两栏布局，整体不变，只是挪到了第 1 行 ===== -->
    <Grid Grid.Row="1" ColumnDefinitions="250,*">

      <!-- ===== 侧边栏 ===== -->
      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
        <DockPanel>

          <!-- 顶部标题——上边距从原来的 24 减小到 12，因为上面现在多了
               一条 36px 高的自绘标题栏，视觉上整体内容往下顶了一截，
               适当收紧这个间距让"Sonvert"这几个字不会显得离顶部太远。 -->
          <TextBlock DockPanel.Dock="Top"
                     Text="Sonvert"
                     FontSize="22" FontWeight="Bold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Margin="24,5,24,16" />

          <ListBox ItemsSource="{Binding NavItems}"
                   SelectedItem="{Binding SelectedNavItem}"
                   Background="Transparent"
                   Margin="12,0"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:NavItem">
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           Margin="12,10" />
              </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{StaticResource NavItemHoverBrush}" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{StaticResource NavItemActiveBrush}" />
              </Style>
              <Style Selector="ListBoxItem:selected TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Style>
            </ListBox.Styles>
          </ListBox>

        </DockPanel>
      </Border>

      <!-- ===== 主内容区（完全不变）===== -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">

        <!--
          顶部麦克风监听横幅栏：只在翻译会话运行中显示（IsSessionActive）。
          布局从左到右：呼吸灯 -> 电平指示条 -> 红色方块停止按钮，三者
          紧凑排列在一起，不拉伸铺满整行——之前用 ColumnDefinitions=
          "Auto,*,Auto" 会导致中间格子被塞进一个吃掉所有剩余宽度的
          "*" 列，把停止按钮顶到窗口最右边，跟前面的内容视觉上断开；
          现在改成三列都是 Auto，并且整个 Grid 显式 HorizontalAlignment=
          "Left"，三个元素紧跟在一起，停止按钮就贴在电平条右侧。

          呼吸灯：一个应用了 Breathing 动画的小红点，透明度在 0.3~1.0
          之间无限循环渐变，模拟真实录音设备"正在录制"的呼吸灯效果。

          电平指示条：ItemsControl 遍历 LiveTranslationViewModel.
          LevelSegments（一个 IBrush 集合，每一项就是"这一格现在该显示
          的颜色"，熄灭态和点亮态、点亮时该是绿/黄/红，都是 ViewModel
          算好的，这里只管渲染）。格数、格子宽度、间距比之前小/密，
          做出更长更细的"音轨"观感。
        -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto" Margin="24,20"
              IsVisible="{Binding IsSessionActive}" ColumnSpacing="12"
              HorizontalAlignment="Left">

          <Ellipse Grid.Column="0" Classes="Breathing"
                   Width="10" Height="10" Fill="{StaticResource DangerBrush}"
                   VerticalAlignment="Center" />

          <ItemsControl Grid.Column="1"
                        ItemsSource="{Binding LiveTranslation.LevelSegments}"
                        VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="1.5" VerticalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Rectangle Width="2" Height="16" Fill="{Binding}"
                           RadiusX="0.5" RadiusY="0.5" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 红色方块停止按钮：沿用媒体播放器"实心方块=停止"的通用
               视觉惯例，不放文字。 -->
          <Button Grid.Column="2"
                  Command="{Binding StopSessionCommand}"
                  Width="16" Height="16" Padding="0"
                  Background="{StaticResource DangerBrush}"
                  CornerRadius="3"
                  VerticalAlignment="Center"
                  ToolTip.Tip="停止翻译" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding SelectedNavItem.Title, StringFormat='{}{0} 页面待搭建'}"
                   IsVisible="{Binding CurrentPage, Converter={x:Static conv:ObjectConverters.IsNull}}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16" />

        <ContentControl Grid.Row="1"
                         Content="{Binding CurrentPage}"
                         IsVisible="{Binding CurrentPage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
      </Grid>

    </Grid>
  </Grid>
</Window>