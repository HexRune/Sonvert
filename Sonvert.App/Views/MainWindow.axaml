<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sonvert.App.ViewModels"
        xmlns:models="using:Sonvert.App.Models"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="Sonvert.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sonvert - 实时同声传译"
        Width="1200" Height="800"
        Background="{StaticResource BackgroundBrush}"
        RequestedThemeVariant="Dark"

        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="-1">

  <!--
    整体改成上下两段：第 0 行是自绘的标题栏（拖拽区域 + 右上角三个窗口
    按钮），第 1 行是原来的"侧边栏+内容区"两栏布局，整体不变，只是被
    包进了这个外层 Grid 的第二行。ExtendClientAreaToDecorationsHint 让
    窗口内容占满了系统标题栏原本的位置，NoChrome 让系统不再自己画任何
    标题栏/按钮，完全由这里的 XAML 负责。
  -->
  <Grid RowDefinitions="36,*">

    <!-- ===== 自绘标题栏 ===== -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
          Background="{StaticResource SidebarBrush}"
          Name="TitleBarDragArea">

      <!-- 左边这一大块留空、不放任何内容——按要求不显示图标/软件名，
           但这块区域本身要能拖拽窗口，靠 code-behind 里对整个
           TitleBarDragArea 注册的 PointerPressed 处理，不需要在这里
           单独再包一层。 -->

      <!-- 右上角窗口控制按钮：最小化 / 最大化还原 / 关闭 -->
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Name="MinimizeButton"
                Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                Classes="TitleBarButton" />
        <Button Name="MaximizeRestoreButton"
                Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                Classes="TitleBarButton" />
        <Button Name="CloseButton"
                Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                Classes="TitleBarButton TitleBarCloseButton" />
      </StackPanel>

      <Grid.Styles>
        <Style Selector="Button.TitleBarButton">
          <Setter Property="Width" Value="46" />
          <Setter Property="Height" Value="36" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
          <Setter Property="FontSize" Value="10" />
          <Setter Property="CornerRadius" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TitleBarButton:pointerover">
          <Setter Property="Background" Value="{StaticResource NavItemHoverBrush}" />
          <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <!-- 关闭按钮悬停单独给红色警示色，跟其余两个按钮区分开，
             这是系统标题栏的通用习惯，用户会本能地按这个预期去找关闭按钮。 -->
        <Style Selector="Button.TitleBarCloseButton:pointerover">
          <Setter Property="Background" Value="{StaticResource DangerBrush}" />
          <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
      </Grid.Styles>
    </Grid>

    <!-- ===== 原来的两栏布局，整体不变，只是挪到了第 1 行 ===== -->
    <Grid Grid.Row="1" ColumnDefinitions="250,*">

      <!-- ===== 侧边栏 ===== -->
      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
        <DockPanel>

          <!-- 顶部标题——上边距从原来的 24 减小到 12，因为上面现在多了
               一条 36px 高的自绘标题栏，视觉上整体内容往下顶了一截，
               适当收紧这个间距让"Sonvert"这几个字不会显得离顶部太远。 -->
          <TextBlock DockPanel.Dock="Top"
                     Text="Sonvert"
                     FontSize="22" FontWeight="Bold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Margin="24,5,24,16" />

          <ListBox ItemsSource="{Binding NavItems}"
                   SelectedItem="{Binding SelectedNavItem}"
                   Background="Transparent"
                   Margin="12,0"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:NavItem">
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           Margin="12,10" />
              </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{StaticResource NavItemHoverBrush}" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{StaticResource NavItemActiveBrush}" />
              </Style>
              <Style Selector="ListBoxItem:selected TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Style>
            </ListBox.Styles>
          </ListBox>

        </DockPanel>
      </Border>

      <!-- ===== 主内容区（完全不变）===== -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20"
              IsVisible="{Binding IsSessionActive}">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Fill="{StaticResource DangerBrush}" />
            <TextBlock Text="正在监听麦克风..."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <Button Grid.Column="1"
                  Content="停止"
                  Command="{Binding StopSessionCommand}"
                  Background="{StaticResource DangerBrush}"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  Padding="20,8"
                  CornerRadius="6" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding SelectedNavItem.Title, StringFormat='{}{0} 页面待搭建'}"
                   IsVisible="{Binding CurrentPage, Converter={x:Static conv:ObjectConverters.IsNull}}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16" />

        <ContentControl Grid.Row="1"
                         Content="{Binding CurrentPage}"
                         IsVisible="{Binding CurrentPage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
      </Grid>

    </Grid>
  </Grid>
</Window>